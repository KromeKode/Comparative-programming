# A repository where main and a branch called soups have both moved on.
git init -q cafe
cd cafe
save() { tick; git add --all; git commit -q -m "$1"; }
printf 'Soup 4\nSalad 5\n' > menu.txt
save "Start the menu"
git switch -q -c soups
printf 'Leek soup: leeks, potatoes, stock\n' > leek.txt
save "Add leek soup"
printf 'Tomato soup: tomatoes, onions, stock\n' > tomato.txt
save "Add tomato soup"
git switch -q main
printf 'Ada\n' > staff.txt
save "Add the staff list"
printf 'Open 9 to 5\n' > hours.txt
save "Add opening hours"
