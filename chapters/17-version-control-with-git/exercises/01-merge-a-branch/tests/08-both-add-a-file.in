git init -q
save() { tick; git add --all; git commit -q -m "$1"; }

printf 'Soup\nSalad\n' > menu.txt
save "Start the menu"

git switch -q -c feature
printf 'Buy flour\nFix the door\n' > todo.txt
save "Add a to-do list"

git switch -q main
printf 'Fix the door\nPaint the sign\n' > todo.txt
save "Add a list of jobs"
