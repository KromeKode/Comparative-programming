git init -q
save() { tick; git add --all; git commit -q -m "$1"; }
# change runs a sed command on a file, in place.
change() { sed "$1" "$2" > "$2.new"; mv "$2.new" "$2"; }
for i in $(seq 1 30); do echo "line $i" >> long.txt; done
for day in Monday Tuesday Wednesday Thursday Friday; do echo "$day: closed" >> week.txt; done
printf 'Soup\n' > menu.txt
save "Start the shop"

git switch -q -c feature
for i in 1 2 3 4 5 6; do
    change "s/^line $((i * 5))\$/line $((i * 5)) from feature/" long.txt
    save "Change line $((i * 5)) on feature"
done
change 's/^Monday: closed$/Monday: 9 to 5/; s/^Friday: closed$/Friday: 9 to 1/' week.txt
save "Open on Monday and Friday"
printf 'Soup\nPie\n' > menu.txt
save "Add pie"

git switch -q main
for i in 1 2 3; do
    change "s/^line $((i * 10))\$/line $((i * 10)) from main/" long.txt
    save "Change line $((i * 10)) on main"
done
change 's/^line 2$/line 2 from main/' long.txt
save "Change line 2 on main"
change 's/^Monday: closed$/Monday: 10 to 4/; s/^Wednesday: closed$/Wednesday: 10 to 4/' week.txt
save "Open on Monday and Wednesday"
printf 'Ada\nGrace\n' > staff.txt
save "Add the staff list"
