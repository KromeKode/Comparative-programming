git init -q
save() { tick; git add --all; git commit -q -m "$1"; }

# check.sh is the test. It passes when every dish on the menu has a price from
# 1 to 20, fails when one doesn't, and exits 125 when there is no menu to check.
cat > check.sh <<'END'
#!/bin/sh
[ -d menu ] || exit 125
for dish in menu/*; do
    price=$(cat "$dish")
    [ "$price" -ge 1 ] 2> /dev/null && [ "$price" -le 20 ] || exit 1
done
END
chmod +x check.sh
mkdir menu
echo 4 > menu/soup
save "Open the shop"

# add puts a dish on the menu, in a file of its own that holds its price.
add() {
    echo "$2" > "menu/$1"
    save "Add $1"
}

add salad 5
git tag v1.0
add bread 2
git mv menu draft
save "Start rewriting the menu"
echo 3 > draft/pie
save "Add pie to the draft"
echo 1 > draft/tea
save "Add tea to the draft"
echo 2 > draft/coffee
save "Add coffee to the draft"
git mv draft menu
save "Finish rewriting the menu"
add cake 4
echo 25 > menu/cake
save "Charge more for cake"
add jam 1
add juice 3
