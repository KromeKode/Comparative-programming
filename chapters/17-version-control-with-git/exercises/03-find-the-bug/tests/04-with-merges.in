git init -q
save() { tick; git add --all; git commit -q -m "$1"; }

# check.sh is the test. It passes when every dish on the menu has a price from
# 1 to 20, fails when one doesn't, and exits 125 when there is no menu to check.
cat > check.sh <<'END'
#!/bin/sh
[ -d menu ] || exit 125
for dish in menu/*; do
    price=$(cat "$dish")
    [ "$price" -ge 1 ] 2> /dev/null && [ "$price" -le 20 ] || exit 1
done
END
chmod +x check.sh
mkdir menu
echo 4 > menu/soup
save "Open the shop"

# add puts a dish on the menu, in a file of its own that holds its price.
add() {
    echo "$2" > "menu/$1"
    save "Add $1"
}

add salad 5
git tag v1.0
add bread 2
git switch -q -c drinks
add tea 1
add coffee 2
echo 30 > menu/coffee
save "Make coffee dearer"
add juice 3
git switch -q main
add pie 3
add cake 4
git merge -q -m "Merge the drinks" drinks
add jam 1
