The last line is never finished: it is left out of the list, or in C, left without its newline.

--- c/wrap.c
-    if (line_length > 0) out[length++] = '\n';
--- cpp/wrap.cpp
-    if (!line.empty()) lines.push_back(line);
--- rust/src/lib.rs
-    if !line.is_empty() {
-        lines.push(line);
-    }
--- go/wrap.go
-	if line != "" {
-		lines = append(lines, line)
-	}
--- python/wrap.py
-    if line != "":
-        lines.append(line)
--- javascript/wrap.js
-  if (line !== "") {
-    lines.push(line);
-  }
--- typescript/wrap.ts
-  if (line !== "") {
-    lines.push(line);
-  }
--- dart/lib/wrap.dart
-  if (line.isNotEmpty) {
-    lines.add(line);
-  }
--- kotlin/src/main/kotlin/Wrap.kt
-    if (line.isNotEmpty()) {
-        lines += line
-    }
