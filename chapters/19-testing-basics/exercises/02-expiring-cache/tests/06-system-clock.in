Putting a key reads the computer's clock instead of the cache's clock.

--- c/cache.c
-bool cache_put(struct cache *cache, const char *key, const char *value) {
-    long long now = clock_now(cache);
+bool cache_put(struct cache *cache, const char *key, const char *value) {
+    long long now = cache_system_clock.now(NULL);
