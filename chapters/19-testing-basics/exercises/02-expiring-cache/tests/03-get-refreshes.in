--- kotlin/src/main/kotlin/Cache.kt
-        val entry = entries[key] ?: return null
-        return if (entry.isLive(clock.now())) entry.value else null
+        val now = clock.now()
+        val entry = entries[key] ?: return null
+        if (!entry.isLive(now)) return null
