The units can come in any order, though each only once, so 30m1h is 90 minutes.

--- c/duration.c
-    size_t next_unit = 0;  // each part's unit comes after the one before it in UNITS
+    bool seen[4] = {false};  // the units so far
-        if (unit < next_unit) return false;  // out of order, or twice
+        if (seen[unit]) return false;  // twice
-        next_unit = unit + 1;
+        seen[unit] = true;
--- cpp/duration.cpp
-    std::size_t next_unit = 0;  // each part's unit comes after the one before it in UNITS
+    bool seen[4] = {};  // the units so far
-        if (unit < next_unit) throw not_a_duration(text, "has a unit out of order, or twice");
+        if (seen[unit]) throw not_a_duration(text, "has a unit twice");
-        next_unit = unit + 1;
+        seen[unit] = true;
