0 seconds formats as empty text, and not as 0s.

--- c/duration.c
-    if (length == 0) strcpy(text, "0s");
--- cpp/duration.cpp
-    if (seconds == 0) return "0s";
--- rust/src/lib.rs
-    if seconds == 0 {
-        return "0s".to_string();
-    }
